{# Single submission detail: all field values plus spam diagnostics.
   Values come from submission.values (submit-time snapshot), so this view
   stays correct even after the form's fields are renamed or removed. #}
{% extends '_layouts/cp' %}
{% set title = 'Submission'|t('recranet-forms') ~ (submission.incrementalId ? ' #' ~ submission.incrementalId) %}
{% set selectedSubnavItem = 'submissions' %}

{% set crumbs = [{ label: 'Submissions'|t('recranet-forms'), url: url('recranet-forms/submissions') }] %}

{% block content %}
	{% if submission.anonymizedAt %}
		{# Retention pruning blanked the personal data; the empty values below are by design #}
		<div class="warning-alert warning with-icon" style="margin-bottom: 24px;">
			{{ 'Anonymized on {date} — the personal data of this submission has been removed by the retention policy.'|t('recranet-forms', { date: submission.anonymizedAt|datetime('short') }) }}
		</div>
	{% endif %}

	{% if submission.isSpam %}
		<div class="warning-alert warning with-icon" style="margin-bottom: 24px;">
			<strong>{{ 'Flagged as spam:'|t('recranet-forms') }}</strong> {{ submission.spamReason }}
			{% if submission.spamScore is not null %}{{ '(score: {score})'|t('recranet-forms', { score: submission.spamScore }) }}{% endif %}
		</div>
	{% elseif submission.sendError %}
		{# Saved but the notification never went out — the data is safe, resend manually #}
		<div class="error-alert error with-icon" style="margin-bottom: 24px;">
			<strong>{{ 'Notification failed:'|t('recranet-forms') }}</strong> {{ submission.sendError }}
		</div>
	{% elseif submission.spamReason %}
		{# Accepted despite a reCAPTCHA config error — surface it for diagnosis #}
		<div class="warning-alert warning with-icon" style="margin-bottom: 24px;">
			{{ submission.spamReason }}
		</div>
	{% endif %}

	<table class="data fullwidth">
		<tbody>
			<tr>
				<th class="light">{{ 'Form'|t('recranet-forms') }}</th>
				<td>{{ form ? form.name : '—' }}</td>
			</tr>
			<tr>
				<th class="light">{{ 'Submitted'|t('recranet-forms') }}</th>
				<td>{{ submission.dateCreated|datetime('short') }}</td>
			</tr>
			{% if submission.sourceUrl %}
				<tr>
					<th class="light">{{ 'Source'|t('recranet-forms') }}</th>
					<td>{{ submission.sourceUrl }}</td>
				</tr>
			{% endif %}
			{# Layout-only rows (heading, paragraph) are already excluded by submission.values #}
			{% for row in submission.values %}
				<tr>
					<th class="light">{{ row.label }}</th>
					<td>
						{% if row.type == 'checkbox' or row.type == 'consent' %}
							{{ row.value ? 'Yes'|t('recranet-forms') : 'No'|t('recranet-forms') }}
						{% elseif row.type == 'file' %}
							{# File value = asset id; link to the asset's edit page #}
							{% set asset = row.value ? craft.assets.id(row.value).one() : null %}
							{% if asset %}
								<a href="{{ asset.cpEditUrl }}">{{ asset.filename }}</a>
							{% else %}
								—
							{% endif %}
						{% elseif row.value is iterable %}
							{# Multi-value fields (checkboxes) read as a comma-joined list #}
							{{ row.value|join(', ') }}
						{% else %}
							{{ row.value|nl2br }}
						{% endif %}
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
{% endblock %}
