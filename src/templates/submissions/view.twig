{# Single submission detail: all field values plus spam diagnostics.
   Values come from submission.values (submit-time snapshot), so this view
   stays correct even after the form's fields are renamed or removed. #}
{% extends '_layouts/cp' %}
{% set title = 'Submission'|t('recranet-forms') ~ (submission.incrementalId ? ' #' ~ submission.incrementalId) %}
{% set selectedSubnavItem = 'submissions' %}

{% set crumbs = [{ label: 'Submissions'|t('recranet-forms'), url: url('recranet-forms/submissions') }] %}

{% block content %}
	{% if submission.anonymizedAt %}
		{# Retention pruning blanked the personal data; the empty values below are by design #}
		<div class="warning-alert warning with-icon" style="margin-bottom: 24px;">
			{{ 'Anonymized on {date} — the personal data of this submission has been removed by the retention policy.'|t('recranet-forms', { date: submission.anonymizedAt|datetime('short') }) }}
		</div>
	{% endif %}

	{% if submission.isSpam %}
		<div class="warning-alert warning with-icon" style="margin-bottom: 24px;">
			<strong>{{ 'Flagged as spam:'|t('recranet-forms') }}</strong> {{ submission.spamReason }}
			{% if submission.spamScore is not null %}{{ '(score: {score})'|t('recranet-forms', { score: submission.spamScore }) }}{% endif %}
		</div>
	{% elseif submission.sendError %}
		{# Saved but the notification never went out — the data is safe, resend manually #}
		<div class="error-alert error with-icon" style="margin-bottom: 24px;">
			<strong>{{ 'Notification failed:'|t('recranet-forms') }}</strong> {{ submission.sendError }}
		</div>
	{% elseif submission.spamReason %}
		{# Accepted despite a reCAPTCHA config error — surface it for diagnosis #}
		<div class="warning-alert warning with-icon" style="margin-bottom: 24px;">
			{{ submission.spamReason }}
		</div>
	{% endif %}

	{# Recovery / resend actions. Spam → "Not spam" clears the flag (reason is
	   kept as "Overridden: …") and sends the skipped emails; sent/failed →
	   "Resend notification" re-delivers the owner notification. Both POST to
	   the CP controller, which flashes the result and redirects back here. #}
	<div class="flex" style="margin-bottom: 24px;">
		{% if submission.isSpam %}
			<form method="post" accept-charset="UTF-8">
				{{ csrfInput() }}
				{{ actionInput('recranet-forms/submissions/mark-ham') }}
				{{ hiddenInput('submissionId', submission.id) }}
				<button type="submit" class="btn submit">{{ 'Not spam'|t('recranet-forms') }}</button>
			</form>
		{% else %}
			<form method="post" accept-charset="UTF-8">
				{{ csrfInput() }}
				{{ actionInput('recranet-forms/submissions/resend') }}
				{{ hiddenInput('submissionId', submission.id) }}
				<button type="submit" class="btn">{{ 'Resend notification'|t('recranet-forms') }}</button>
			</form>
		{% endif %}

		{# Block the sender straight from the message that prompted it. Two
		   scopes, because "this one mailbox" and "this whole domain" are
		   genuinely different decisions. Already-blocked senders show state
		   instead of a second button that would do nothing. #}
		{% if sender %}
			{% if senderBlocked or domainBlocked %}
				<span class="rf-blocked-note">
					{{ (domainBlocked and not senderBlocked ? 'Domain is on the blocklist.' : 'Sender is on the blocklist.')|t('recranet-forms') }}
					<a href="{{ url('recranet-forms/blocklist') }}">{{ 'Manage blocklist'|t('recranet-forms') }}</a>
				</span>
			{% else %}
				<form method="post" accept-charset="UTF-8">
					{{ csrfInput() }}
					{{ actionInput('recranet-forms/blocklist/add') }}
					{{ hiddenInput('submissionId', submission.id) }}
					{{ hiddenInput('pattern', sender) }}
					<button type="submit" class="btn">{{ 'Block {sender}'|t('recranet-forms', { sender: sender }) }}</button>
				</form>
				{% if senderDomain %}
					<form method="post" accept-charset="UTF-8">
						{{ csrfInput() }}
						{{ actionInput('recranet-forms/blocklist/add') }}
						{{ hiddenInput('submissionId', submission.id) }}
						{{ hiddenInput('pattern', senderDomain) }}
						<button type="submit" class="btn">{{ 'Block all of {domain}'|t('recranet-forms', { domain: senderDomain }) }}</button>
					</form>
				{% endif %}
			{% endif %}
		{% endif %}
	</div>

	<table class="data fullwidth">
		<tbody>
			<tr>
				<th class="light">{{ 'Form'|t('recranet-forms') }}</th>
				<td>{{ form ? form.name : '—' }}</td>
			</tr>
			<tr>
				<th class="light">{{ 'Submitted'|t('recranet-forms') }}</th>
				<td>{{ submission.dateCreated|datetime('short') }}</td>
			</tr>
			{% if submission.sourceUrl %}
				<tr>
					<th class="light">{{ 'Source'|t('recranet-forms') }}</th>
					<td>{{ submission.sourceUrl }}</td>
				</tr>
			{% endif %}
			{% if submission.paymentStatus %}
				<tr>
					<th class="light">{{ 'Payment'|t('recranet-forms') }}</th>
					<td>
						€ {{ (submission.paymentAmount / 100)|number_format(2, ',', '.') }}
						— {{ ('payment.status.' ~ submission.paymentStatus)|t('recranet-forms') }}
						{% if submission.paymentId %}<code>{{ submission.paymentId }}</code>{% endif %}
					</td>
				</tr>
			{% endif %}
			{# Layout-only rows (heading, paragraph) are already excluded by submission.values #}
			{% for row in submission.values %}
				<tr>
					<th class="light">{{ row.label }}</th>
					<td>
						{% if row.type == 'checkbox' or row.type == 'consent' %}
							{{ row.value ? 'Yes'|t('recranet-forms') : 'No'|t('recranet-forms') }}
						{% elseif row.type == 'file' %}
							{# File value = asset id; link to the asset's edit page #}
							{% set asset = row.value ? craft.assets.id(row.value).one() : null %}
							{% if asset %}
								<a href="{{ asset.cpEditUrl }}">{{ asset.filename }}</a>
							{% else %}
								—
							{% endif %}
						{% elseif row.value is iterable %}
							{# Multi-value fields (checkboxes) read as a comma-joined list #}
							{{ row.value|join(', ') }}
						{% else %}
							{{ row.value|nl2br }}
						{% endif %}
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	{# Editor notes: internal remarks on this submission ("called them back",
	   "quote sent"). Optionally emailed to the notification recipients. #}
	<h2 style="margin-top: 36px;">{{ 'Notes'|t('recranet-forms') }}</h2>

	{% for note in submission.notes %}
		<div class="pane" style="margin-bottom: 12px; padding: 12px 16px;">
			<p style="white-space: pre-wrap; margin: 0 0 8px;">{{ note.text }}</p>
			<div class="flex" style="align-items: center;">
				<span class="light">{{ note.author }} — {{ note.date|datetime('short') }}</span>
				<form method="post" accept-charset="UTF-8">
					{{ csrfInput() }}
					{{ actionInput('recranet-forms/submissions/delete-note') }}
					{{ hiddenInput('submissionId', submission.id) }}
					{{ hiddenInput('noteIndex', loop.index0) }}
					<button type="submit" class="delete icon" title="{{ 'Remove note'|t('recranet-forms') }}" aria-label="{{ 'Remove note'|t('recranet-forms') }}"></button>
				</form>
			</div>
		</div>
	{% else %}
		<p class="light">{{ 'No notes yet.'|t('recranet-forms') }}</p>
	{% endfor %}

	<form method="post" accept-charset="UTF-8" style="max-width: 60ch; margin-top: 16px;">
		{{ csrfInput() }}
		{{ actionInput('recranet-forms/submissions/add-note') }}
		{{ hiddenInput('submissionId', submission.id) }}
		<textarea name="text" class="text fullwidth" rows="3" placeholder="{{ 'Add a note…'|t('recranet-forms') }}" aria-label="{{ 'Notes'|t('recranet-forms') }}"></textarea>
		<div class="flex" style="margin-top: 8px; align-items: center;">
			<label><input type="checkbox" name="email" value="1" /> {{ 'Also email this note to the notification recipients'|t('recranet-forms') }}</label>
			<button type="submit" class="btn submit">{{ 'Add note'|t('recranet-forms') }}</button>
		</div>
	</form>
{% endblock %}

{% css %}
	/* Sits in the same flex row as the action buttons */
	.rf-blocked-note { align-self: center; font-size: 13px; color: var(--medium-text-color); }
{% endcss %}
