{# Forms overview: list of all forms with new/import/duplicate/export actions. #}
{% extends '_layouts/cp' %}
{% set title = 'Forms'|t('recranet-forms') %}
{% set selectedSubnavItem = 'forms' %}

{% block actionButton %}
	<div class="btngroup">
		<a href="{{ url('recranet-forms/forms/import') }}" class="btn">{{ 'Import'|t('recranet-forms') }}</a>
		<a href="{{ url('recranet-forms/forms/new') }}" class="btn submit add icon">{{ 'New form'|t('recranet-forms') }}</a>
	</div>
{% endblock %}

{% block content %}
	{% if forms|length %}
		<table class="data fullwidth">
			<thead>
				<tr>
					<th>{{ 'Name'|t('recranet-forms') }}</th>
					<th>{{ 'Handle'|t('recranet-forms') }}</th>
					<th>{{ 'Fields'|t('recranet-forms') }}</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{% for form in forms %}
					<tr>
						<td><a href="{{ url('recranet-forms/forms/' ~ form.id) }}"><strong>{{ form.name }}</strong></a></td>
						<td><code>{{ form.handle }}</code></td>
						<td>{{ form.fields|length }}</td>
						<td class="rightalign">
							<a class="btn small" href="{{ url('recranet-forms/forms/' ~ form.id ~ '/export') }}">{{ 'Export'|t('recranet-forms') }}</a>
							{# Duplicate clones the form with fresh field uids and remapped conditions #}
							<button
								type="button"
								class="btn small"
								onclick="Craft.postActionRequest('recranet-forms/forms/duplicate', { formId: {{ form.id }} }, () => window.location.reload());"
							>
								{{ 'Duplicate'|t('recranet-forms') }}
							</button>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	{% else %}
		<p>{{ 'No forms yet. Create one to get started.'|t('recranet-forms') }}</p>
	{% endif %}
{% endblock %}
