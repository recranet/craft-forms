{# Plugin settings: captcha provider, spam pipeline, storage/retention/uploads. Keys support $ENV_VAR syntax. #}
{% import '_includes/forms' as forms %}

{# Sections are grouped in tabs (same pattern as the form builder cards);
   plain buttons + hidden panes, no dependencies. All inputs stay in the DOM,
   so every tab posts with the single settings form. Each pane opens with a
   short intro and is split into <h3> sub-sections. One tab per QUESTION an
   admin arrives with: spam, emails, what's stored, uploads, payments —
   captcha and the local checks are one subject, retention belongs with
   storage, and the email language no longer hides under "Storage". #}
<nav class="rfs-tabs" aria-label="{{ 'Settings sections'|t('recranet-forms') }}">
	<button type="button" class="rfs-tab sel" data-rfs-tab="captcha">{{ 'Spam protection'|t('recranet-forms') }}</button>
	<button type="button" class="rfs-tab" data-rfs-tab="emails">{{ 'Emails'|t('recranet-forms') }}</button>
	<button type="button" class="rfs-tab" data-rfs-tab="storage">{{ 'Storage & retention'|t('recranet-forms') }}</button>
	<button type="button" class="rfs-tab" data-rfs-tab="uploads">{{ 'Uploads'|t('recranet-forms') }}</button>
	<button type="button" class="rfs-tab" data-rfs-tab="payments">{{ 'Payments'|t('recranet-forms') }}</button>
</nav>

{# ---------------------------------------------------------------- Captcha #}
<div class="rfs-pane" data-rfs-pane="captcha">
<p class="rf-settings-intro">{{ 'settings.captcha.intro'|t('recranet-forms') }}</p>

<h3>{{ 'Provider'|t('recranet-forms') }}</h3>
<p class="rf-settings-hint">{{ 'settings.captcha.provider.hint'|t('recranet-forms') }}</p>

{{
	forms.selectField({
		label: 'Provider'|t('recranet-forms'),
		instructions: 'Which captcha verifies submissions. "None" disables captcha verification (honeypot and timing checks still run).'|t('recranet-forms'),
		name: 'captchaProvider',
		value: settings.captchaProvider,
		options: [
			{ value: 'none', label: 'None'|t('recranet-forms') },
			{ value: 'recaptcha-v2', label: 'Google reCAPTCHA v2 (checkbox)'|t('recranet-forms') },
			{ value: 'recaptcha-v3', label: 'Google reCAPTCHA v3 (invisible, scored)'|t('recranet-forms') },
			{ value: 'recaptcha-enterprise', label: 'Google reCAPTCHA Enterprise'|t('recranet-forms') },
			{ value: 'turnstile', label: 'Cloudflare Turnstile (experimental)'|t('recranet-forms') }
		],
		errors: settings.getErrors('captchaProvider')
	})
}}

{# Provider-dependent visibility (data-rfs-show lists the providers a block
   applies to): an editor only sees the fields the chosen provider actually
   uses. Everything stays in the DOM, so hidden values still post unchanged. #}
<div data-rfs-show="recaptcha-v2 recaptcha-v3 recaptcha-enterprise turnstile">
<h3>{{ 'Keys'|t('recranet-forms') }}</h3>
<p class="rf-settings-hint">{{ 'settings.captcha.keys.hint'|t('recranet-forms') }}</p>
<p class="rf-settings-hint">{{ 'settings.captcha.keys.scope'|t('recranet-forms') }}</p>

<div data-rfs-show="recaptcha-v2 recaptcha-v3 recaptcha-enterprise">
	{{
		forms.autosuggestField({
			label: 'reCAPTCHA site key'|t('recranet-forms'),
			name: 'recaptchaSiteKey',
			suggestEnvVars: true,
			value: settings.recaptchaSiteKey,
			errors: settings.getErrors('recaptchaSiteKey')
		})
	}}
</div>

<div data-rfs-show="recaptcha-v2 recaptcha-v3">
	{{
		forms.autosuggestField({
			label: 'reCAPTCHA secret key'|t('recranet-forms'),
			name: 'recaptchaSecretKey',
			suggestEnvVars: true,
			value: settings.recaptchaSecretKey,
			errors: settings.getErrors('recaptchaSecretKey')
		})
	}}
</div>

<div data-rfs-show="recaptcha-enterprise">
	{{
		forms.autosuggestField({
			label: 'Google Cloud project ID'|t('recranet-forms'),
			name: 'recaptchaProjectId',
			suggestEnvVars: true,
			value: settings.recaptchaProjectId,
			errors: settings.getErrors('recaptchaProjectId')
		})
	}}

	{{
		forms.autosuggestField({
			label: 'Google Cloud API key'|t('recranet-forms'),
			name: 'recaptchaApiKey',
			suggestEnvVars: true,
			value: settings.recaptchaApiKey,
			errors: settings.getErrors('recaptchaApiKey')
		})
	}}
</div>

<div data-rfs-show="turnstile">
	{{
		forms.autosuggestField({
			label: 'Turnstile site key'|t('recranet-forms'),
			name: 'turnstileSiteKey',
			suggestEnvVars: true,
			value: settings.turnstileSiteKey,
			errors: settings.getErrors('turnstileSiteKey')
		})
	}}

	{{
		forms.autosuggestField({
			label: 'Turnstile secret key'|t('recranet-forms'),
			name: 'turnstileSecretKey',
			suggestEnvVars: true,
			value: settings.turnstileSecretKey,
			errors: settings.getErrors('turnstileSecretKey')
		})
	}}
</div>
</div>

{# The sections below are collapsible (native <details>): the defaults are
   sane, so a fresh install only needs the provider + keys above. Closed
   details still post — the inputs never leave the DOM. #}
<details class="rfs-group" data-rfs-show="recaptcha-v3 recaptcha-enterprise">
<summary><strong>{{ 'Scoring'|t('recranet-forms') }}</strong><span class="rfs-group__hint">{{ '0.5 / 0.3 by default — tune only when real submissions get flagged'|t('recranet-forms') }}</span></summary>
<p class="rf-settings-hint">{{ 'settings.captcha.scoring.hint'|t('recranet-forms') }}</p>

<div>
	{{
		forms.textField({
			label: 'Score threshold'|t('recranet-forms'),
			instructions: 'Submissions scoring below this (0–1) are flagged as spam. Default 0.5.'|t('recranet-forms'),
			name: 'recaptchaThreshold',
			size: 5,
			value: settings.recaptchaThreshold,
			errors: settings.getErrors('recaptchaThreshold')
		})
	}}

	{{
		forms.textField({
			label: 'Reject threshold'|t('recranet-forms'),
			instructions: 'Below this score a submission is definite spam: rejected outright and not stored. Between the two thresholds it is stored as reviewable spam. Default 0.3.'|t('recranet-forms'),
			name: 'recaptchaRejectThreshold',
			size: 5,
			value: settings.recaptchaRejectThreshold,
			errors: settings.getErrors('recaptchaRejectThreshold')
		})
	}}

	{{
		forms.lightswitchField({
			label: 'Hide the reCAPTCHA badge'|t('recranet-forms'),
			instructions: 'Allowed by Google; the form then shows the required reCAPTCHA attribution text automatically.'|t('recranet-forms'),
			name: 'recaptchaHideBadge',
			on: settings.recaptchaHideBadge
		})
	}}
</div>
</details>

<details class="rfs-group" data-rfs-show="recaptcha-v2 recaptcha-v3 recaptcha-enterprise turnstile">
<summary><strong>{{ 'Failure handling'|t('recranet-forms') }}</strong><span class="rfs-group__hint">{{ 'What happens when the captcha itself breaks — never treated as spam'|t('recranet-forms') }}</span></summary>
<p class="rf-settings-hint">{{ 'settings.captcha.failure.hint'|t('recranet-forms') }}</p>

{{
	forms.lightswitchField({
		label: 'Fail open on verification errors'|t('recranet-forms'),
		instructions: 'When the captcha itself breaks (bad keys, provider unreachable): **on** accepts and flags submissions with a logged warning; **off** shows visitors an error. A broken captcha is never treated as spam. Tip: run `php craft recranet-forms/captcha/check` on deploy.'|t('recranet-forms'),
		name: 'recaptchaFailOpen',
		on: settings.recaptchaFailOpen
	})
}}

{{
	forms.lightswitchField({
		label: 'Verify token hostname'|t('recranet-forms'),
		instructions: 'Reject v3/Enterprise tokens minted on another hostname, so tokens farmed elsewhere cannot be replayed here.'|t('recranet-forms'),
		name: 'verifyCaptchaHostname',
		on: settings.verifyCaptchaHostname
	})
}}

{{
	forms.autosuggestField({
		label: 'Allowed token hostnames'|t('recranet-forms'),
		instructions: 'Comma-separated. Empty = the hostname of the request.'|t('recranet-forms'),
		name: 'captchaAllowedHostnames',
		suggestEnvVars: true,
		value: settings.captchaAllowedHostnames,
		errors: settings.getErrors('captchaAllowedHostnames')
	})
}}
</details>

{# Local checks: always on, whatever the captcha choice — they run BEFORE
   the captcha in the pipeline, so bots never cost a verification #}
<details class="rfs-group">
<summary><strong>{{ 'Automatic bot checks'|t('recranet-forms') }}</strong><span class="rfs-group__hint">{{ 'Honeypot, submit timing and throttle — on by default, invisible to visitors'|t('recranet-forms') }}</span></summary>
<p class="rf-settings-hint">{{ 'settings.spam.intro'|t('recranet-forms') }}</p>

<h3>{{ 'Honeypot'|t('recranet-forms') }}</h3>
<p class="rf-settings-hint">{{ 'settings.spam.honeypot.hint'|t('recranet-forms') }}</p>

{{
	forms.lightswitchField({
		label: 'Honeypot'|t('recranet-forms'),
		instructions: 'Render a hidden field; bots that fill it are rejected outright.'|t('recranet-forms'),
		name: 'honeypotEnabled',
		on: settings.honeypotEnabled
	})
}}

{{
	forms.textField({
		label: 'Honeypot field name'|t('recranet-forms'),
		name: 'honeypotName',
		value: settings.honeypotName,
		errors: settings.getErrors('honeypotName')
	})
}}

<h3>{{ 'Timing'|t('recranet-forms') }}</h3>
<p class="rf-settings-hint">{{ 'settings.spam.timing.hint'|t('recranet-forms') }}</p>

{{
	forms.textField({
		label: 'Minimum submit time (seconds)'|t('recranet-forms'),
		instructions: 'Submissions arriving faster than this after the form was rendered are rejected as bots. 0 disables the check.'|t('recranet-forms'),
		name: 'minSubmitSeconds',
		size: 5,
		value: settings.minSubmitSeconds,
		errors: settings.getErrors('minSubmitSeconds')
	})
}}

<h3>{{ 'Throttle'|t('recranet-forms') }}</h3>
<p class="rf-settings-hint">{{ 'settings.spam.throttle.hint'|t('recranet-forms') }}</p>

{# Throttle: max submits per IP + form within a rolling window (cache-backed) #}
{{
	forms.textField({
		label: 'Submission throttle (count)'|t('recranet-forms'),
		instructions: 'Maximum number of submissions per visitor (IP address) per form within the throttle window. Exceeding submits are rejected outright. 0 disables the check.'|t('recranet-forms'),
		name: 'throttleCount',
		size: 5,
		value: settings.throttleCount,
		errors: settings.getErrors('throttleCount')
	})
}}

{{
	forms.textField({
		label: 'Throttle window (seconds)'|t('recranet-forms'),
		instructions: 'The rolling window for the submission throttle. 0 disables the check.'|t('recranet-forms'),
		name: 'throttleWindow',
		size: 5,
		value: settings.throttleWindow,
		errors: settings.getErrors('throttleWindow')
	})
}}
</details>

<details class="rfs-group">
<summary><strong>{{ 'Blocklist'|t('recranet-forms') }}</strong><span class="rfs-group__hint">{{ 'Block known senders by address, domain or IP — for human spam a captcha can’t catch'|t('recranet-forms') }}</span></summary>
<p class="rf-settings-hint">{{ 'settings.spam.blocklist.hint'|t('recranet-forms') }}</p>

{{
	forms.textareaField({
		label: 'Sender blocklist'|t('recranet-forms'),
		instructions: 'Comma-separated, for human-driven spam a captcha score cannot catch. Entry shapes: full address (`someone@example.com`), domain suffix (`@spamdomain.ru`), local-part prefix (`someone`), IP prefix (`198.51.100.`). Matches are stored as reviewable spam.'|t('recranet-forms'),
		name: 'blocklist',
		rows: 3,
		value: settings.blocklist,
		errors: settings.getErrors('blocklist')
	})
}}
</details>
</div>

{# ----------------------------------------------------------------- Emails #}
<div class="rfs-pane" data-rfs-pane="emails" hidden>
{# Wegwijzer: recipients, subjects, intro/body texts and templates are all
   per-form settings — this tab only holds what is truly plugin-wide #}
<p class="rf-settings-intro">{{ 'Recipients, subjects, texts and templates are configured per form (on the form’s Notification and Confirmation tabs). This tab holds the plugin-wide email behavior.'|t('recranet-forms') }}</p>

<p class="rf-settings-hint">{{ 'settings.language.hint'|t('recranet-forms') }}</p>

{{
	forms.selectField({
		label: 'Notification language'|t('recranet-forms'),
		name: 'notificationLanguage',
		value: settings.notificationLanguage,
		options: [
			{ value: 'submission', label: 'The site the visitor submitted on'|t('recranet-forms') },
			{ value: 'primary', label: 'Always the primary site’s language'|t('recranet-forms') }
		],
		errors: settings.getErrors('notificationLanguage')
	})
}}
</div>

{# ---------------------------------------------------- Storage & retention #}
<div class="rfs-pane" data-rfs-pane="storage" hidden>
<p class="rf-settings-intro">{{ 'settings.storage.intro'|t('recranet-forms') }}</p>

{{
	forms.lightswitchField({
		label: 'Save submissions'|t('recranet-forms'),
		instructions: 'Off = notification emails still go out, but nothing is stored in the database (mail-only mode).'|t('recranet-forms'),
		name: 'saveSubmissions',
		on: settings.saveSubmissions
	})
}}

{{
	forms.lightswitchField({
		label: 'Save spam submissions'|t('recranet-forms'),
		instructions: 'Keep spam-flagged submissions for review in the control panel. Off = flagged spam is dropped.'|t('recranet-forms'),
		name: 'saveSpamSubmissions',
		on: settings.saveSpamSubmissions
	})
}}

<h3>{{ 'Retention'|t('recranet-forms') }}</h3>
<p class="rf-settings-hint">{{ 'settings.retention.intro'|t('recranet-forms') }}</p>

{{
	forms.textField({
		label: 'Retention (days)'|t('recranet-forms'),
		instructions: 'Delete stored submissions older than this many days (runs with Craft’s garbage collection, or via `php craft recranet-forms/gc/prune`). 0 keeps them forever. Match this to the site’s privacy statement.'|t('recranet-forms')
			~ ' ' ~ 'Individual forms can override this retention period and can anonymize instead of delete (see the form’s settings).'|t('recranet-forms'),
		name: 'retentionDays',
		size: 5,
		value: settings.retentionDays,
		errors: settings.getErrors('retentionDays')
	})
}}

<h3>{{ 'Privacy'|t('recranet-forms') }}</h3>

{{
	forms.autosuggestField({
		label: 'Privacy page URL'|t('recranet-forms'),
		instructions: 'Link to the site’s privacy page, shown below every form. May be a relative path like `/privacy`. Empty = no link.'|t('recranet-forms'),
		name: 'privacyPolicyUrl',
		suggestEnvVars: true,
		value: settings.privacyPolicyUrl,
		errors: settings.getErrors('privacyPolicyUrl')
	})
}}
</div>

{# ---------------------------------------------------------------- Uploads #}
<div class="rfs-pane" data-rfs-pane="uploads" hidden>
<p class="rf-settings-intro">{{ 'settings.uploads.intro'|t('recranet-forms') }}</p>

{# File-field uploads: which volume, how big, which extensions #}
{% set volumeOptions = [{ value: '', label: 'None (file fields disabled)'|t('recranet-forms') }] %}
{% for volume in craft.app.volumes.allVolumes %}
	{% set volumeOptions = volumeOptions|merge([{ value: volume.handle, label: volume.name }]) %}
{% endfor %}
{{
	forms.selectField({
		label: 'Upload volume'|t('recranet-forms'),
		instructions: 'Asset volume for file-field uploads, stored in a subfolder named after the form handle. Without a volume, forms with a file field reject uploads with a validation error.'|t('recranet-forms'),
		name: 'uploadVolume',
		value: settings.uploadVolume,
		options: volumeOptions,
		errors: settings.getErrors('uploadVolume')
	})
}}

{{
	forms.textField({
		label: 'Maximum upload size (MB)'|t('recranet-forms'),
		instructions: 'Per file. PHP’s `upload_max_filesize`/`post_max_size` still apply on top of this.'|t('recranet-forms'),
		name: 'maxUploadSize',
		size: 5,
		value: settings.maxUploadSize,
		errors: settings.getErrors('maxUploadSize')
	})
}}

{{
	forms.textField({
		label: 'Allowed file extensions'|t('recranet-forms'),
		instructions: 'Comma-separated allowlist for file fields. Keep executable/scriptable types (svg, html, php) out unless a project truly needs them.'|t('recranet-forms'),
		name: 'allowedFileExtensions',
		value: settings.allowedFileExtensions,
		errors: settings.getErrors('allowedFileExtensions')
	})
}}
</div>

{# --------------------------------------------------------------- Payments #}
<div class="rfs-pane" data-rfs-pane="payments" hidden>
<p class="rf-settings-intro">{{ 'settings.payments.intro'|t('recranet-forms') }}</p>

{{
	forms.selectField({
		label: 'Payment provider'|t('recranet-forms'),
		instructions: 'Hosted checkout: the visitor pays on the provider’s page, no payment data touches this site. Enable payment per form in the form’s settings.'|t('recranet-forms'),
		name: 'paymentProvider',
		value: settings.paymentProvider,
		options: [
			{ value: 'none', label: 'None'|t('recranet-forms') },
			{ value: 'mollie', label: 'Mollie' }
		],
		errors: settings.getErrors('paymentProvider')
	})
}}

<div data-rfs-payment-show="mollie">
	{{
		forms.autosuggestField({
			label: 'Mollie API key'|t('recranet-forms'),
			instructions: 'A `test_` key puts every payment in Mollie’s test mode — shown as a badge in the form builder and on the form, so a test setup is never mistaken for a live one.'|t('recranet-forms'),
			name: 'mollieApiKey',
			suggestEnvVars: true,
			value: settings.mollieApiKey,
			errors: settings.getErrors('mollieApiKey')
		})
	}}
</div>
</div>

{% css %}
	.rfs-tabs { display: flex; gap: 2px; margin-bottom: 24px; border-bottom: 1px solid var(--hairline-color); }
	.rfs-tab { border: 0; background: none; padding: 8px 14px; font-size: 14px; color: var(--medium-text-color); cursor: pointer; border-radius: 4px 4px 0 0; }
	.rfs-tab.sel { color: var(--text-color); background: var(--gray-100); font-weight: 600; }

	/* Pane intro: one short paragraph explaining what the tab is for */
	.rf-settings-intro { max-width: 65ch; margin: 0 0 24px; color: var(--medium-text-color); }
	/* Sub-section heading inside a pane, with its own small hint line(s) */
	.rfs-pane h3 { margin: 32px 0 4px; font-size: 14px; font-weight: 700; color: var(--text-color); }
	.rfs-pane > h3:first-of-type { margin-top: 0; }
	.rf-settings-hint { max-width: 65ch; margin: 0 0 16px; font-size: 12px; line-height: 1.4; color: var(--medium-text-color); }
	/* Two stacked hints (e.g. the keys scope note) read as one block */
	.rf-settings-hint + .rf-settings-hint { margin-top: -12px; }

	/* Collapsible setting groups: summary = title + one-line hint. Closed
	   by default — the defaults are sane; open automatically on errors (JS) */
	.rfs-group { margin: 16px 0; border: 1px solid var(--hairline-color); border-radius: var(--large-border-radius); }
	.rfs-group > summary { display: flex; align-items: baseline; gap: 10px; padding: 12px 16px; cursor: pointer; list-style: none; }
	.rfs-group > summary::-webkit-details-marker { display: none; }
	.rfs-group > summary::before { content: '\25B8'; color: var(--medium-text-color); transition: transform 0.12s ease; }
	.rfs-group[open] > summary::before { transform: rotate(90deg); }
	.rfs-group[open] > summary { border-bottom: 1px solid var(--hairline-color); margin-bottom: 12px; }
	.rfs-group__hint { font-size: 12px; font-weight: 400; color: var(--medium-text-color); }
	.rfs-group > :not(summary) { margin-left: 16px; margin-right: 16px; }
	.rfs-group > :last-child:not(summary) { padding-bottom: 16px; }
	.rfs-group h3:first-of-type { margin-top: 0; }
{% endcss %}

{% js %}
	(function () {
		var tabs = document.querySelectorAll('.rfs-tab');
		tabs.forEach(function (tab) {
			tab.addEventListener('click', function () {
				tabs.forEach(function (t) { t.classList.toggle('sel', t === tab); });
				document.querySelectorAll('.rfs-pane').forEach(function (pane) {
					pane.hidden = pane.dataset.rfsPane !== tab.dataset.rfsTab;
				});
			});
		});

		// Provider-dependent visibility: each data-rfs-show block lists the
		// providers it applies to. Hidden inputs stay in the DOM and post
		// unchanged, so switching providers never wipes stored keys.
		// Craft namespaces the settings form, so the name is settings[captchaProvider].
		var providerSelect = document.querySelector('select[name$="[captchaProvider]"], select[name="captchaProvider"]');
		if (!providerSelect) return;

		function applyProviderVisibility() {
			var provider = providerSelect.value;
			document.querySelectorAll('[data-rfs-show]').forEach(function (block) {
				block.hidden = block.dataset.rfsShow.split(' ').indexOf(provider) === -1;
			});
		}

		providerSelect.addEventListener('change', applyProviderVisibility);
		applyProviderVisibility();

		// Same pattern for the payment provider's key fields
		var paymentSelect = document.querySelector('select[name$="[paymentProvider]"], select[name="paymentProvider"]');
		if (!paymentSelect) return;

		function applyPaymentVisibility() {
			document.querySelectorAll('[data-rfs-payment-show]').forEach(function (block) {
				block.hidden = block.dataset.rfsPaymentShow.split(' ').indexOf(paymentSelect.value) === -1;
			});
		}

		paymentSelect.addEventListener('change', applyPaymentVisibility);
		applyPaymentVisibility();

		// A validation error inside a collapsed group must never hide from
		// the editor — open every group that contains one
		document.querySelectorAll('details.rfs-group').forEach(function (group) {
			if (group.querySelector('ul.errors, .error')) group.open = true;
		});
	})();
{% endjs %}
