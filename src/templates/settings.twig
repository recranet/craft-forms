{# Plugin settings: captcha provider, spam pipeline, storage/retention. Keys support $ENV_VAR syntax. #}
{% import '_includes/forms' as forms %}

<h2>Captcha</h2>

{{
	forms.selectField({
		label: 'Provider',
		instructions: 'Which captcha verifies submissions. "None" disables captcha verification (honeypot and timing checks still run).',
		name: 'captchaProvider',
		value: settings.captchaProvider,
		options: [
			{ value: 'none', label: 'None' },
			{ value: 'recaptcha-v2', label: 'Google reCAPTCHA v2 (checkbox)' },
			{ value: 'recaptcha-v3', label: 'Google reCAPTCHA v3 (invisible, scored)' },
			{ value: 'recaptcha-enterprise', label: 'Google reCAPTCHA Enterprise' },
			{ value: 'turnstile', label: 'Cloudflare Turnstile (experimental)' }
		],
		errors: settings.getErrors('captchaProvider')
	})
}}

<div>
	{{
		forms.autosuggestField({
			label: 'reCAPTCHA site key',
			name: 'recaptchaSiteKey',
			suggestEnvVars: true,
			value: settings.recaptchaSiteKey,
			errors: settings.getErrors('recaptchaSiteKey')
		})
	}}

	{{
		forms.autosuggestField({
			label: 'reCAPTCHA secret key',
			instructions: 'Used by v2 and v3 (Enterprise uses the API key below).',
			name: 'recaptchaSecretKey',
			suggestEnvVars: true,
			value: settings.recaptchaSecretKey,
			errors: settings.getErrors('recaptchaSecretKey')
		})
	}}
</div>

<div>
	{{
		forms.textField({
			label: 'Score threshold',
			instructions: 'Submissions scoring below this (0–1) are flagged as spam. Default 0.5.',
			name: 'recaptchaThreshold',
			size: 5,
			value: settings.recaptchaThreshold,
			errors: settings.getErrors('recaptchaThreshold')
		})
	}}

	{{
		forms.textField({
			label: 'Reject threshold',
			instructions: 'Below this score a submission is definite spam: rejected outright and not stored. Between the two thresholds it is stored as reviewable spam. Default 0.3.',
			name: 'recaptchaRejectThreshold',
			size: 5,
			value: settings.recaptchaRejectThreshold,
			errors: settings.getErrors('recaptchaRejectThreshold')
		})
	}}

	{{
		forms.lightswitchField({
			label: 'Hide the reCAPTCHA badge',
			instructions: 'Allowed by Google as long as the form shows the reCAPTCHA attribution text.',
			name: 'recaptchaHideBadge',
			on: settings.recaptchaHideBadge
		})
	}}
</div>

<div>
	{{
		forms.autosuggestField({
			label: 'Google Cloud project ID',
			name: 'recaptchaProjectId',
			suggestEnvVars: true,
			value: settings.recaptchaProjectId,
			errors: settings.getErrors('recaptchaProjectId')
		})
	}}

	{{
		forms.autosuggestField({
			label: 'Google Cloud API key',
			name: 'recaptchaApiKey',
			suggestEnvVars: true,
			value: settings.recaptchaApiKey,
			errors: settings.getErrors('recaptchaApiKey')
		})
	}}
</div>

<div>
	{{
		forms.autosuggestField({
			label: 'Turnstile site key',
			name: 'turnstileSiteKey',
			suggestEnvVars: true,
			value: settings.turnstileSiteKey,
			errors: settings.getErrors('turnstileSiteKey')
		})
	}}

	{{
		forms.autosuggestField({
			label: 'Turnstile secret key',
			name: 'turnstileSecretKey',
			suggestEnvVars: true,
			value: settings.turnstileSecretKey,
			errors: settings.getErrors('turnstileSecretKey')
		})
	}}
</div>

{{
	forms.lightswitchField({
		label: 'Fail open on verification errors',
		instructions: 'When the captcha itself breaks (bad keys, provider unreachable): **on** accepts and flags submissions with a logged warning; **off** shows visitors an error. A broken captcha is never treated as spam. Tip: run `php craft recranet-forms/captcha/check` on deploy.',
		name: 'recaptchaFailOpen',
		on: settings.recaptchaFailOpen
	})
}}

{{
	forms.lightswitchField({
		label: 'Verify token hostname',
		instructions: 'Reject v3/Enterprise tokens minted on another hostname, so tokens farmed elsewhere cannot be replayed here.',
		name: 'verifyCaptchaHostname',
		on: settings.verifyCaptchaHostname
	})
}}

{{
	forms.autosuggestField({
		label: 'Allowed token hostnames',
		instructions: 'Comma-separated. Empty = the hostname of the request.',
		name: 'captchaAllowedHostnames',
		suggestEnvVars: true,
		value: settings.captchaAllowedHostnames,
		errors: settings.getErrors('captchaAllowedHostnames')
	})
}}

<hr />

<h2>Spam checks</h2>

{{
	forms.lightswitchField({
		label: 'Honeypot',
		instructions: 'Render a hidden field; bots that fill it are rejected outright.',
		name: 'honeypotEnabled',
		on: settings.honeypotEnabled
	})
}}

{{
	forms.textField({
		label: 'Honeypot field name',
		name: 'honeypotName',
		value: settings.honeypotName,
		errors: settings.getErrors('honeypotName')
	})
}}

{{
	forms.textField({
		label: 'Minimum submit time (seconds)',
		instructions: 'Submissions arriving faster than this after the form was rendered are rejected as bots. 0 disables the check.',
		name: 'minSubmitSeconds',
		size: 5,
		value: settings.minSubmitSeconds,
		errors: settings.getErrors('minSubmitSeconds')
	})
}}

{{
	forms.textareaField({
		label: 'Sender blocklist',
		instructions: 'Comma-separated, for human-driven spam a captcha score cannot catch. Entry shapes: full address (`someone@example.com`), domain suffix (`@spamdomain.ru`), local-part prefix (`someone`), IP prefix (`198.51.100.`). Matches are stored as reviewable spam.',
		name: 'blocklist',
		rows: 3,
		value: settings.blocklist,
		errors: settings.getErrors('blocklist')
	})
}}

<hr />

<h2>Storage</h2>

{{
	forms.lightswitchField({
		label: 'Save submissions',
		instructions: 'Off = notification emails still go out, but nothing is stored in the database (mail-only mode).',
		name: 'saveSubmissions',
		on: settings.saveSubmissions
	})
}}

{{
	forms.lightswitchField({
		label: 'Save spam submissions',
		instructions: 'Keep spam-flagged submissions for review in the control panel. Off = flagged spam is dropped.',
		name: 'saveSpamSubmissions',
		on: settings.saveSpamSubmissions
	})
}}

{{
	forms.textField({
		label: 'Retention (days)',
		instructions: 'Delete stored submissions older than this many days (runs with Craft’s garbage collection, or via `php craft recranet-forms/gc/prune`). 0 keeps them forever. Match this to the site’s privacy statement.',
		name: 'retentionDays',
		size: 5,
		value: settings.retentionDays,
		errors: settings.getErrors('retentionDays')
	})
}}
