{# Standalone page loaded in the preview iframe on the form edit screen.
   Deliberately minimal: it must not inherit CP styling, because the point is
   to show what the form/email template itself produces. #}
<!doctype html>
<html lang="{{ craft.app.language }}">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{{ title }}</title>
		<style>
			body { margin: 0; font-family: system-ui, sans-serif; background: #fff; color: #1e2a44; }
			.rf-preview-note { padding: 8px 16px; background: #eef2f8; border-bottom: 1px solid #dbe3ee; font-size: 12px; color: #5b6a88; }
			.rf-preview-body { padding: 20px; max-width: 720px; }
		</style>
		{% if withFormCss ?? false %}
		{# Neutral styling for the Bootstrap class names the default form
		   template emits — bundled instead of loading Bootstrap from a CDN,
		   so the preview also works when the CP has no internet access.
		   Covers exactly what _render/form.twig uses; extend when it does. #}
		<style>
			*, *::before, *::after { box-sizing: border-box; }
			.row { display: flex; flex-wrap: wrap; margin: 0 -8px; }
			.row.g-3 > * { padding: 0 8px; margin-top: 16px; }
			.col-12 { flex: 0 0 100%; max-width: 100%; }
			@media (min-width: 576px) { .col-md-6 { flex: 0 0 50%; max-width: 50%; } }
			.form-label { display: inline-block; margin-bottom: 6px; font-weight: 600; font-size: 14px; }
			.form-label.fs-6 { font-size: 14px; }
			.form-text { display: block; margin-top: 4px; font-size: 12px; color: #5b6a88; }
			.form-control, .form-select { display: block; width: 100%; padding: 8px 10px; font: inherit; font-size: 14px; color: inherit; background: #fff; border: 1px solid #c2cbd9; border-radius: 6px; }
			textarea.form-control { min-height: 90px; }
			.form-check { display: flex; gap: 8px; align-items: flex-start; }
			.form-check-input { width: 16px; height: 16px; margin-top: 2px; flex: none; }
			.form-check-label { font-size: 14px; }
			.is-invalid { border-color: #b3261e; }
			.invalid-feedback.d-block { display: block; margin-top: 4px; font-size: 12px; color: #b3261e; }
			.btn.btn-primary { display: inline-block; margin-top: 16px; padding: 9px 18px; font: inherit; font-size: 14px; font-weight: 600; color: #fff; background: #2f5fe0; border: 0; border-radius: 6px; cursor: pointer; }
			.alert { padding: 10px 14px; margin-bottom: 16px; border-radius: 6px; font-size: 14px; }
			.alert-success { background: #e7f4ec; color: #1d5c36; }
			.alert-danger { background: #fbeceb; color: #8c2723; }
			.h6 { font-size: 15px; font-weight: 700; margin: 0 0 4px; }
			.mb-0 { margin-bottom: 0; }
			.visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
		</style>
		{% endif %}
		{{ head() }}
	</head>
	<body>
		{{ beginBody() }}
		<p class="rf-preview-note">{{ note }}</p>
		<div class="rf-preview-body">{{ body|raw }}</div>
		{# endBody() emits the JS the rendered template registered. Without it
		   the preview silently dropped every {% js %} block, so conditional
		   fields never showed their behaviour and a payment form's running
		   total sat on its server-rendered starting value. #}
		{{ endBody() }}
	</body>
</html>
