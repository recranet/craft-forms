{# Default front-end form render (Bootstrap 5 markup, matches the boilerplate style).
   Override per project with templates/recranet-forms/form.twig.
   Variables: form, options (class, buttonLabel, redirect), formErrors, formContent, erroredFormHandle. #}

{% set settings = craft.app.plugins.getPlugin('recranet-forms').settings %}
{# Only show this form's errors/values when it was the one that failed #}
{% set hasErrors = erroredFormHandle == form.handle %}
{% set errors = hasErrors ? formErrors : {} %}
{% set values = hasErrors ? formContent : {} %}
{% set formId = 'form-' ~ form.handle %}
{# Autocomplete tokens by field type, so browsers can assist (a11y + UX) #}
{% set autocompleteMap = { email: 'email', tel: 'tel' } %}

<form method="post" id="{{ formId }}" class="{{ options.class ?? '' }}" accept-charset="UTF-8">
	{{ csrfInput() }}
	{{ actionInput('recranet-forms/submissions/submit') }}
	{{ redirectInput(options.redirect ?? craft.app.request.pathInfo ~ '?submitted=true') }}
	{{ hiddenInput('formHandle', form.handle|hash) }}

	{# Honeypot: visually hidden, labeled to be ignored by autofill/screen readers #}
	<div style="position: absolute; left: -9999px;" aria-hidden="true">
		<input type="text" name="{{ settings.honeypotName }}" tabindex="-1" autocomplete="off" />
	</div>

	{% if craft.app.session.hasFlash('success') %}
		<div class="alert alert-success" role="status">{{ craft.app.session.getFlash('success') }}</div>
	{% elseif craft.app.session.hasFlash('error') %}
		<div class="alert alert-danger" role="alert">{{ craft.app.session.getFlash('error') }}</div>
	{% endif %}

	{# Error summary: announced immediately by screen readers on re-render #}
	{% if errors|length %}
		<div class="alert alert-danger" role="alert" tabindex="-1" id="{{ formId }}-errors">
			<ul class="mb-0">
				{% for fieldErrors in errors %}
					{% for error in fieldErrors %}<li>{{ error }}</li>{% endfor %}
				{% endfor %}
			</ul>
		</div>
	{% endif %}

	<div class="row g-3">
		{% for field in form.fields %}
			{% set inputId = formId ~ '-' ~ field.handle %}
			{% set errorId = inputId ~ '-error' %}
			{% set fieldErrors = errors[field.handle] ?? [] %}
			{% set value = values[field.handle] ?? null %}
			{% set autocomplete = autocompleteMap[field.type] ?? null %}
			{# Half-width fields sit side by side from md up #}
			<div class="col-12 {{ (field.width ?? 'full') == 'half' ? 'col-md-6' }}">
				{% if field.type == 'checkbox' %}
					<div class="form-check">
						<input
							type="checkbox"
							class="form-check-input {{ fieldErrors ? 'is-invalid' }}"
							name="fields[{{ field.handle }}]"
							id="{{ inputId }}"
							value="1"
							{{ value ? 'checked' }}
							{{ field.required ? 'required' }}
							{% if fieldErrors %}aria-invalid="true" aria-describedby="{{ errorId }}"{% endif %}
						/>
						<label class="form-check-label" for="{{ inputId }}">
							{{ field.label }}{% if field.required %} <sup aria-hidden="true">*</sup>{% endif %}
						</label>
					</div>
				{% else %}
					<label class="form-label" for="{{ inputId }}">
						{{ field.label }}{% if field.required %} <sup aria-hidden="true">*</sup>{% endif %}
					</label>
					{% if field.type == 'textarea' %}
						<textarea
							class="form-control {{ fieldErrors ? 'is-invalid' }}"
							name="fields[{{ field.handle }}]"
							id="{{ inputId }}"
							rows="6"
							{{ field.required ? 'required' }}
							{% if fieldErrors %}aria-invalid="true" aria-describedby="{{ errorId }}"{% endif %}
						>{{ value }}</textarea>
					{% elseif field.type == 'select' %}
						<select
							class="form-select {{ fieldErrors ? 'is-invalid' }}"
							name="fields[{{ field.handle }}]"
							id="{{ inputId }}"
							{{ field.required ? 'required' }}
							{% if fieldErrors %}aria-invalid="true" aria-describedby="{{ errorId }}"{% endif %}
						>
							<option value=""></option>
							{% for option in field.options|split(',')|map(o => o|trim)|filter(o => o) %}
								<option value="{{ option }}" {{ value == option ? 'selected' }}>{{ option }}</option>
							{% endfor %}
						</select>
					{% else %}
						<input
							type="{{ field.type }}"
							class="form-control {{ fieldErrors ? 'is-invalid' }}"
							name="fields[{{ field.handle }}]"
							id="{{ inputId }}"
							value="{{ value }}"
							{{ field.required ? 'required' }}
							{% if autocomplete %}autocomplete="{{ autocomplete }}"{% endif %}
							{% if fieldErrors %}aria-invalid="true" aria-describedby="{{ errorId }}"{% endif %}
						/>
					{% endif %}
				{% endif %}
				{% if fieldErrors %}
					<div class="invalid-feedback d-block" id="{{ errorId }}">{{ fieldErrors|join(' ') }}</div>
				{% endif %}
			</div>
		{% endfor %}

		<div class="col-12">
			<button type="submit" class="btn btn-primary">{{ options.buttonLabel ?? 'Send' }}</button>
		</div>
	</div>

	{{ craft.recranetForms.recaptchaTag() }}
</form>
