{# Default front-end form render (Bootstrap 5 markup, matches the boilerplate style).
   Override per project with templates/recranet-forms/form.twig.
   Variables: form, options (class, buttonLabel, redirect), formErrors, formContent, erroredFormHandle. #}

{% set settings = craft.app.plugins.getPlugin('recranet-forms').settings %}
{# Only show this form's errors/values when it was the one that failed #}
{% set hasErrors = erroredFormHandle == form.handle %}
{% set errors = hasErrors ? formErrors : {} %}
{% set values = hasErrors ? formContent : {} %}
{% set formId = 'form-' ~ form.handle %}
{# Autocomplete tokens by field type, so browsers can assist (a11y + UX) #}
{% set autocompleteMap = { email: 'email', tel: 'tel', url: 'url' } %}
{# inputmode hints mobile keyboards toward the right layout #}
{% set inputmodeMap = { number: 'numeric' } %}

{# enctype is unconditional so adding a file field to a form never needs a template change #}
<form method="post" id="{{ formId }}" class="{{ options.class ?? '' }}" accept-charset="UTF-8" enctype="multipart/form-data"{{ (options.ajax ?? false) ? ' data-rf-ajax' }}>
	{{ csrfInput() }}
	{{ actionInput('recranet-forms/submissions/submit') }}
	{# Parenthesized: Twig's ?? binds tighter than ~, so without them the
	   suffix would be appended to a caller-provided redirect too #}
	{# The fragment lands the visitor back AT the form after the reload. A form
	   halfway down a page otherwise reloads to the top, where the success
	   message is off screen and the submit looks like it did nothing. Works
	   without JS; the block at the bottom of this template covers the
	   validation-error path, which re-renders instead of redirecting. #}
	{{ redirectInput(options.redirect ?? (craft.app.request.pathInfo ~ '?submitted=true#' ~ formId)) }}
	{{ hiddenInput('formHandle', form.handle|hash) }}

	{% if settings.honeypotEnabled %}
		{# Honeypot: visually hidden, labeled to be ignored by autofill/screen readers #}
		<div style="position: absolute; left: -9999px;" aria-hidden="true">
			<input type="text" name="{{ settings.honeypotName }}" tabindex="-1" autocomplete="off" />
		</div>
	{% endif %}

	{# tabindex="-1" so the JS at the bottom can move focus here after a submit:
	   that both announces the outcome and brings it into view #}
	{% if craft.app.session.hasFlash('success') %}
		<div class="alert alert-success" role="status" tabindex="-1" data-rf-feedback>{{ craft.app.session.getFlash('success') }}</div>
	{% elseif craft.app.session.hasFlash('error') %}
		<div class="alert alert-danger" role="alert" tabindex="-1" data-rf-feedback>{{ craft.app.session.getFlash('error') }}</div>
	{% endif %}

	{# Error summary: announced immediately by screen readers on re-render #}
	{% if errors|length %}
		<div class="alert alert-danger" role="alert" tabindex="-1" id="{{ formId }}-errors">
			<ul class="mb-0">
				{% for fieldErrors in errors %}
					{% for error in fieldErrors %}<li>{{ error }}</li>{% endfor %}
				{% endfor %}
			</ul>
		</div>
	{% endif %}

	<div class="row g-3">
		{% for field in form.fields %}
			{% set inputId = formId ~ '-' ~ field.handle %}
			{% set errorId = inputId ~ '-error' %}
			{% set descriptionId = inputId ~ '-description' %}
			{% set fieldErrors = errors[field.handle] ?? [] %}
			{# Editor-set default value fills the initial render; posted values win on re-render #}
			{% set value = values[field.handle] ?? field.defaultValue ?? null %}
			{% set autocomplete = autocompleteMap[field.type] ?? null %}
			{% set inputmode = inputmodeMap[field.type] ?? null %}
			{% set description = field.description ?? '' %}
			{# Consent uses the description AS the checkbox label and a paragraph
			   uses it AS the content — don't render it a second time below #}
			{% set showDescription = description and field.type not in ['consent', 'paragraph'] %}
			{# aria-describedby points at the description and/or the error text #}
			{% set describedBy = [showDescription ? descriptionId, fieldErrors ? errorId]|filter(v => v)|join(' ') %}
			{# Conditional visibility rules, if any — consumed by the inline JS below.
			   Twig's html auto-escaping turns the JSON's double quotes into &quot;,
			   so the encoded blob is safe inside a double-quoted attribute. #}
			{% set conditions = field.conditions ?? null %}
			{% if field.type == 'hidden' %}
				{# Hidden field: no label, no visible wrapper. Value = editor default,
				   overridable via a query param matching the handle (?utm=x fills the
				   field with handle "utm"). Sanitized: scalar only, capped at 255
				   chars — the server re-sanitizes in applyPost either way. Never
				   required: there is nothing a visitor could fill in. #}
				{% set queryValue = craft.app.request.getQueryParam(field.handle) %}
				{% set queryValue = queryValue is not null and queryValue is not iterable ? (queryValue ~ '')|slice(0, 255) : null %}
				{# The default is capped like the query seed and the server-side
				   value (255 chars), so rules on this field compare the same
				   string in the browser and on the server #}
				<input
					type="hidden"
					name="fields[{{ field.handle }}]"
					id="{{ inputId }}"
					value="{{ values[field.handle] ?? queryValue ?? ((field.defaultValue ?? '') ~ '')|slice(0, 255) }}"
					data-rf-uid="{{ field.uid }}"
					{% if conditions and (conditions.rules ?? [])|length %}data-rf-conditions="{{ conditions|json_encode }}"{% endif %}
				/>
			{% else %}
			{# Half-width fields sit side by side from md up #}
			<div
				class="col-12 {{ (field.width ?? 'full') == 'half' ? 'col-md-6' }}"
				data-rf-uid="{{ field.uid }}"
				{% if conditions and (conditions.rules ?? [])|length %}data-rf-conditions="{{ conditions|json_encode }}"{% endif %}
			>
				{% if field.type == 'divider' %}
					{# Layout-only: a horizontal rule, never stores a value #}
					<hr class="mb-0" />
				{% elseif field.type == 'heading' %}
					{# Layout-only: renders a heading, never stores a value #}
					<h3 class="mb-0">{{ field.label|t }}</h3>
				{% elseif field.type == 'paragraph' %}
					{# Layout-only: the description is the content, the label an optional small heading #}
					{% if field.label %}<h4 class="h6">{{ field.label|t }}</h4>{% endif %}
					<p class="mb-0">{{ description|t|nl2br }}</p>
				{% elseif field.type == 'radio' %}
					{# Radio group: fieldset + legend gives the group an accessible name #}
					<fieldset {% if describedBy %}aria-describedby="{{ describedBy }}"{% endif %}>
						<legend class="form-label fs-6">
							{{ field.label|t }}{% if field.required %} <sup aria-hidden="true">*</sup><span class="visually-hidden">({{ 'required'|t('recranet-forms') }})</span>{% endif %}
						</legend>
						{% for option in field.options|split(',')|map(o => o|trim)|filter(o => o) %}
							<div class="form-check">
								<input
									type="radio"
									class="form-check-input {{ fieldErrors ? 'is-invalid' }}"
									name="fields[{{ field.handle }}]"
									id="{{ inputId }}-{{ loop.index }}"
									value="{{ option }}"
									{{ value == option ? 'checked' }}
									{{ field.required ? 'required' }}
									{% if fieldErrors %}aria-invalid="true"{% endif %}
								/>
								<label class="form-check-label" for="{{ inputId }}-{{ loop.index }}">{{ option|t }}</label>
							</div>
						{% endfor %}
					</fieldset>
				{% elseif field.type == 'checkboxes' %}
					{# Multi-checkbox group posts as fields[handle][] and stores an array.
					   No `required` attribute: the browser would demand EVERY box, while
					   "at least one" is what required means here — the server enforces it. #}
					{% set checkedValues = value is iterable ? value : (value ? value|split(',')|map(o => o|trim) : []) %}
					<fieldset {% if describedBy %}aria-describedby="{{ describedBy }}"{% endif %}>
						<legend class="form-label fs-6">
							{{ field.label|t }}{% if field.required %} <sup aria-hidden="true">*</sup><span class="visually-hidden">({{ 'required'|t('recranet-forms') }})</span>{% endif %}
						</legend>
						{% for option in field.options|split(',')|map(o => o|trim)|filter(o => o) %}
							<div class="form-check">
								<input
									type="checkbox"
									class="form-check-input {{ fieldErrors ? 'is-invalid' }}"
									name="fields[{{ field.handle }}][]"
									id="{{ inputId }}-{{ loop.index }}"
									value="{{ option }}"
									{{ option in checkedValues ? 'checked' }}
									{% if fieldErrors %}aria-invalid="true"{% endif %}
								/>
								<label class="form-check-label" for="{{ inputId }}-{{ loop.index }}">{{ option|t }}</label>
							</div>
						{% endfor %}
					</fieldset>
				{% elseif field.type == 'checkbox' or field.type == 'consent' %}
					<div class="form-check">
						<input
							type="checkbox"
							class="form-check-input {{ fieldErrors ? 'is-invalid' }}"
							name="fields[{{ field.handle }}]"
							id="{{ inputId }}"
							value="1"
							{{ value ? 'checked' }}
							{{ field.required ? 'required' }}
							{% if fieldErrors %}aria-invalid="true"{% endif %}
							{% if describedBy %}aria-describedby="{{ describedBy }}"{% endif %}
						/>
						{# Consent (GDPR): the checkbox text is the field's description, falling
						   back to the label. The full field row — including this text — is
						   snapshotted on every submission, so exactly what the visitor agreed
						   to stays on record even after the text changes. #}
						<label class="form-check-label" for="{{ inputId }}">
							{{ (field.type == 'consent' ? (description ?: field.label) : field.label)|t }}{% if field.required %} <sup aria-hidden="true">*</sup>{% endif %}
						</label>
					</div>
				{% elseif field.type == 'file' %}
					{# Single file upload; accept narrows the picker to the allowed
					   extensions (server validates the allowlist + size regardless).
					   No value repopulation — browsers don't allow prefilled file inputs. #}
					<label class="form-label" for="{{ inputId }}">
						{{ field.label|t }}{% if field.required %} <sup aria-hidden="true">*</sup>{% endif %}
					</label>
					{% set accept = settings.getAllowedFileExtensions()|map(e => '.' ~ e)|join(',') %}
					<input
						type="file"
						class="form-control {{ fieldErrors ? 'is-invalid' }}"
						name="fields[{{ field.handle }}]"
						id="{{ inputId }}"
						{% if accept %}accept="{{ accept }}"{% endif %}
						{{ field.required ? 'required' }}
						{% if fieldErrors %}aria-invalid="true"{% endif %}
						{% if describedBy %}aria-describedby="{{ describedBy }}"{% endif %}
					/>
				{% else %}
					<label class="form-label" for="{{ inputId }}">
						{{ field.label|t }}{% if field.required %} <sup aria-hidden="true">*</sup>{% endif %}
					</label>
					{% if field.type == 'textarea' %}
						<textarea
							class="form-control {{ fieldErrors ? 'is-invalid' }}"
							name="fields[{{ field.handle }}]"
							id="{{ inputId }}"
							rows="6"
							{% if field.placeholder ?? false %}placeholder="{{ field.placeholder|t }}"{% endif %}
							{{ field.required ? 'required' }}
							{% if fieldErrors %}aria-invalid="true"{% endif %}
							{% if describedBy %}aria-describedby="{{ describedBy }}"{% endif %}
						>{{ value }}</textarea>
					{% elseif field.type == 'select' %}
						<select
							class="form-select {{ fieldErrors ? 'is-invalid' }}"
							name="fields[{{ field.handle }}]"
							id="{{ inputId }}"
							{{ field.required ? 'required' }}
							{% if fieldErrors %}aria-invalid="true"{% endif %}
							{% if describedBy %}aria-describedby="{{ describedBy }}"{% endif %}
						>
							<option value=""></option>
							{% for option in field.options|split(',')|map(o => o|trim)|filter(o => o) %}
								<option value="{{ option }}" {{ value == option ? 'selected' }}>{{ option|t }}</option>
							{% endfor %}
						</select>
					{% else %}
						<input
							type="{{ field.type }}"
							class="form-control {{ fieldErrors ? 'is-invalid' }}"
							name="fields[{{ field.handle }}]"
							id="{{ inputId }}"
							value="{{ value }}"
							{% if field.placeholder ?? false %}placeholder="{{ field.placeholder|t }}"{% endif %}
							{{ field.required ? 'required' }}
							{% if autocomplete %}autocomplete="{{ autocomplete }}"{% endif %}
							{% if inputmode %}inputmode="{{ inputmode }}"{% endif %}
							{% if fieldErrors %}aria-invalid="true"{% endif %}
							{% if describedBy %}aria-describedby="{{ describedBy }}"{% endif %}
						/>
					{% endif %}
				{% endif %}
				{% if showDescription %}
					<div class="form-text" id="{{ descriptionId }}">{{ description|t }}</div>
				{% endif %}
				{% if fieldErrors %}
					<div class="invalid-feedback d-block" id="{{ errorId }}">{{ fieldErrors|join(' ') }}</div>
				{% endif %}
			</div>
			{% endif %}
		{% endfor %}

		{# Payment forms in test mode announce it — a visitor (or a client
		   reviewing the site) must never mistake a test checkout for a real one #}
		{% if form.paymentEnabled ?? false %}
			{% set rfPaymentProvider = craft.app.plugins.getPlugin('recranet-forms').payments.getProvider() %}
			{% if rfPaymentProvider and rfPaymentProvider.isTestMode() %}
				<div class="col-12">
					<div class="alert alert-warning mb-0">{{ 'Test mode — this payment is not real.'|t('recranet-forms') }}</div>
				</div>
			{% endif %}

			{# Running total, so nobody is sent to a checkout without knowing the
			   amount. DISPLAY ONLY: the charge is recomputed server-side by
			   PaymentCalculator from the form definition, so a tampered figure
			   here changes nothing about what is billed. The price table below
			   mirrors that calculator's rules — option label → price, number
			   field → price per unit, plus the form's base amount — and any
			   change to the money math there must land in the JS block at the
			   bottom of this template too. #}
			{% set rfBaseCents = ((form.paymentBase|default('0'))|replace({',': '.'})|default(0)) * 100 %}
			{% set rfPriced = [] %}
			{% for field in form.fields %}
				{% set rfOptionPrices = {} %}
				{% if field.type in ['select', 'radio', 'checkboxes'] and (field.prices ?? '') != '' %}
					{% set rfLabels = field.options|split(',')|map(o => o|trim)|filter(o => o) %}
					{% set rfAmounts = field.prices|split(',')|map(p => p|trim) %}
					{% for i, label in rfLabels %}
						{% set rfCents = ((rfAmounts[i] ?? '0')|replace({',': '.'})|default(0)) * 100 %}
						{% if rfCents > 0 %}
							{% set rfOptionPrices = rfOptionPrices|merge({ (label): rfCents|round }) %}
						{% endif %}
					{% endfor %}
				{% endif %}
				{% set rfUnitCents = field.type == 'number' and (field.price ?? '') != ''
					? (((field.price)|replace({',': '.'})|default(0)) * 100)|round
					: 0 %}
				{% if rfOptionPrices|length or rfUnitCents > 0 %}
					{% set rfPriced = rfPriced|merge([{
						handle: field.handle,
						type: field.type,
						options: rfOptionPrices,
						unit: rfUnitCents,
					}]) %}
				{% endif %}
			{% endfor %}

			{% if rfBaseCents > 0 or rfPriced|length %}
				<div class="col-12">
					<div class="rf-total d-flex justify-content-between align-items-baseline" data-rf-total>
						<span>{{ 'Total'|t('recranet-forms') }}</span>
						{# Rendered server-side so the amount is right before any JS
						   runs (and stays right when there is none): the base
						   amount is what an untouched form owes. #}
						<strong data-rf-total-amount aria-live="polite">{{ (rfBaseCents / 100)|currency('EUR') }}</strong>
					</div>
				</div>
				<script type="application/json" id="{{ formId }}-prices">
					{{ { base: rfBaseCents|round, fields: rfPriced }|json_encode|raw }}
				</script>
			{% endif %}
		{% endif %}

		<div class="col-12">
			{# Label precedence, most specific first: the form's own label (editor
			   content, translated per site — "Bestellen", "Inschrijven"), then a
			   template-provided buttonLabel, then the plugin's translated
			   default. The |t on that default is load-bearing: without it every
			   non-English site showed an English "Send". #}
			{% set submitLabel = form.submitLabel|default('') %}
			<button type="submit" class="btn btn-primary">
				{{- submitLabel != '' ? submitLabel|t('site') : (options.buttonLabel ?? 'Send'|t('recranet-forms')) -}}
			</button>
		</div>

		{# Privacy agreement (plugin setting). With a privacy URL configured,
		   agreeing is mandatory on every form: a required checkbox with the
		   link in its label, enforced server-side too. Forms with their own
		   consent field already carry the agreement — those only get the
		   link. Opens in a new tab so a mid-form click never loses input. #}
		{% set privacyUrl = settings.getPrivacyPolicyUrl() %}
		{% if privacyUrl %}
			{% set hasConsentField = form.fields|filter(f => f.type == 'consent')|length > 0 %}
			{% if hasConsentField %}
				<div class="col-12">
					<div class="form-text rf-privacy-link">
						<a href="{{ privacyUrl }}" target="_blank" rel="noopener">{{ 'Privacy statement'|t('recranet-forms') }}</a>
					</div>
				</div>
			{% else %}
				{% set privacyErrors = errors['rfPrivacyConsent'] ?? [] %}
				<div class="col-12">
					<div class="form-check rf-privacy-consent">
						<input
							type="checkbox"
							class="form-check-input {{ privacyErrors ? 'is-invalid' }}"
							name="rfPrivacyConsent"
							value="1"
							id="{{ formId }}-privacy"
							required
							{% if privacyErrors %}aria-invalid="true" aria-describedby="{{ formId }}-privacy-error"{% endif %}
						/>
						<label class="form-check-label" for="{{ formId }}-privacy">
							{{ 'I agree to the {privacyStatement}.'|t('recranet-forms', {
								privacyStatement: '<a href="' ~ privacyUrl|e('html_attr') ~ '" target="_blank" rel="noopener">' ~ 'privacy statement'|t('recranet-forms') ~ '</a>',
							})|raw }}
							<sup aria-hidden="true">*</sup><span class="visually-hidden">({{ 'required'|t('recranet-forms') }})</span>
						</label>
						{% if privacyErrors %}
							<div class="invalid-feedback d-block" id="{{ formId }}-privacy-error">{{ privacyErrors|join(' ') }}</div>
						{% endif %}
					</div>
				</div>
			{% endif %}
		{% endif %}
	</div>

	{{ craft.recranetForms.captchaTag(form.handle) }}
</form>

{% if options.ajax ?? false %}
{# Ajax submit (options.ajax): posts via fetch with Accept: application/json
   and renders the server's field errors in place — no page reload. Plays
   nice with the captcha scripts: their handler runs first and prevents the
   event while it fetches a token; we only act on the un-prevented re-submit
   (e.defaultPrevented check), so the token is always on board. #}
{% js %}
(function () {
	var form = document.getElementById({{ formId|json_encode|raw }});
	if (!form || !form.hasAttribute('data-rf-ajax')) return;

	function rfReduceMotion() {
		return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	}

	form.addEventListener('submit', function (e) {
		// A captcha handler is still fetching its token — it re-submits when done
		if (e.defaultPrevented) return;
		e.preventDefault();

		var button = form.querySelector('button[type="submit"]');
		if (button) button.disabled = true;

		// Clear the previous round's errors
		form.querySelectorAll('.rf-ajax-error').forEach(function (el) { el.remove(); });
		form.querySelectorAll('.is-invalid').forEach(function (el) { el.classList.remove('is-invalid'); });

		fetch(window.location.href, {
			method: 'POST',
			body: new FormData(form),
			headers: { 'Accept': 'application/json' },
		}).then(function (response) {
			return response.json();
		}).then(function (data) {
			if (data.redirect) {
				window.location.href = data.redirect;
				return;
			}
			if (data.success) {
				// Replace the form with the success message — also kills
				// accidental double submits
				var alert = document.createElement('div');
				alert.className = 'alert alert-success';
				alert.setAttribute('role', 'status');
				alert.setAttribute('tabindex', '-1');
				alert.textContent = data.message || '';
				form.replaceWith(alert);
				// preventScroll + scrollIntoView so the jump is centered and
				// smooth, matching the non-ajax path
				alert.focus({ preventScroll: true });
				alert.scrollIntoView({ behavior: rfReduceMotion() ? 'auto' : 'smooth', block: 'center' });
				return;
			}
			if (button) button.disabled = false;
			// Field errors, same markup as the server-side render
			var firstInvalid = null;
			Object.keys(data.errors || {}).forEach(function (handle) {
				// Regular fields post as fields[handle]; the privacy-consent
				// checkbox (rfPrivacyConsent) posts under its own name
				var input = form.querySelector('[name="fields[' + handle + ']"], [name="fields[' + handle + '][]"], [name="' + handle + '"]');
				if (!input) return;
				input.classList.add('is-invalid');
				if (!firstInvalid) firstInvalid = input;
				var feedback = document.createElement('div');
				feedback.className = 'invalid-feedback d-block rf-ajax-error';
				feedback.textContent = (data.errors[handle] || []).join(' ');
				(input.closest('.col-12') || input.parentNode).appendChild(feedback);
			});
			if (data.message) {
				var errorAlert = document.createElement('div');
				errorAlert.className = 'alert alert-danger rf-ajax-error';
				errorAlert.setAttribute('role', 'alert');
				errorAlert.textContent = data.message;
				form.prepend(errorAlert);
			}
			// The first bad field, not the top of the form: that is where
			// the visitor has to type
			if (firstInvalid) {
				firstInvalid.focus({ preventScroll: true });
				firstInvalid.scrollIntoView({ behavior: rfReduceMotion() ? 'auto' : 'smooth', block: 'center' });
			}
		}).catch(function () {
			// Network/parse trouble: fall back to a normal POST — submit()
			// bypasses this listener, so no loop
			if (button) button.disabled = false;
			form.submit();
		});
	});
})();
{% endjs %}
{% endif %}

{# Conditional fields: front-end half of the evaluator. This is a strict
   mirror of src/rules/RuleEvaluator.php — any semantics change there must
   land here too (normalization, fail-open on malformed rules, cascade with
   hidden fields counting as empty). Hidden fields get the `hidden`
   attribute, their inputs are disabled (so they never post) and `required`
   is lifted (so the browser can't block submit on an invisible field).
   Without JS nothing is ever hidden — the server discards hidden-field
   values on submit either way. #}
{% js %}
// Running payment total. DISPLAY ONLY — PaymentCalculator.php recomputes the
// charge from the form definition on submit, so this figure can never change
// what is billed. It mirrors that calculator's rules, and reads the live DOM
// rather than the field definitions, which means fields hidden by their
// conditions (inputs disabled by the conditional-visibility block below) drop
// out of the total for free.
(function () {
	var form = document.getElementById({{ formId|json_encode|raw }});
	var data = document.getElementById({{ (formId ~ '-prices')|json_encode|raw }});
	var output = form && form.querySelector('[data-rf-total-amount]');

	if (!form || !data || !output) return;

	var table;
	try {
		table = JSON.parse(data.textContent);
	} catch (e) {
		return;
	}

	var money = new Intl.NumberFormat({{ craft.app.locale.id|json_encode|raw }}, {
		style: 'currency',
		currency: 'EUR',
	});

	function inputsFor(handle) {
		return Array.prototype.slice.call(
			form.querySelectorAll('[name="fields[' + handle + ']"], [name="fields[' + handle + '][]"]'),
		);
	}

	function total() {
		var cents = table.base || 0;

		(table.fields || []).forEach(function (field) {
			inputsFor(field.handle).forEach(function (input) {
				// Disabled = hidden by a condition, so it posts nothing and owes nothing
				if (input.disabled) return;

				if (input.type === 'checkbox' || input.type === 'radio') {
					if (input.checked && field.options[input.value]) {
						cents += field.options[input.value];
					}
					return;
				}

				if (input.tagName === 'SELECT') {
					Array.prototype.slice.call(input.selectedOptions).forEach(function (option) {
						if (field.options[option.value]) cents += field.options[option.value];
					});
					return;
				}

				if (field.unit > 0 && input.value !== '') {
					// Whole units, and a negative quantity is never a discount
					var quantity = Math.max(0, parseInt(input.value, 10) || 0);
					cents += quantity * field.unit;
				}
			});
		});

		return cents;
	}

	function refresh() {
		output.textContent = money.format(total() / 100);
	}

	form.addEventListener('change', refresh);
	form.addEventListener('input', refresh);
	refresh();
})();
{% endjs %}

{% js %}
// Land the visitor on the outcome of their submit. The error summary wins
// (that is what they must act on), otherwise the success/error flash.
// focus() moves the screen reader AND scrolls, so one call does both jobs;
// the explicit scroll adds smooth centering where motion is welcome.
(function () {
	var form = document.getElementById({{ formId|json_encode|raw }});
	var target = document.getElementById({{ (formId ~ '-errors')|json_encode|raw }})
		|| (form && form.querySelector('[data-rf-feedback]'));

	if (!target) return;

	target.focus({ preventScroll: true });

	var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
})();
{% endjs %}

{% js %}
(function () {
	var form = document.getElementById({{ formId|json_encode|raw }});
	if (!form) {
		return;
	}

	// Only fields that actually carry conditions ever change visibility
	var conditioned = Array.prototype.slice.call(form.querySelectorAll('[data-rf-conditions]'));
	if (!conditioned.length) {
		return;
	}

	// Mirrors RuleEvaluator::normalize(): trim + lowercase; checkbox state
	// is read as '1'/'' in fieldValue(), null becomes ''
	function normalize(value) {
		return String(value == null ? '' : value).trim().toLowerCase();
	}

	// Current raw value of the field with the given uid. Fields hidden
	// earlier in the cascade count as empty — same as the server, where
	// their values are discarded. Returns null when the uid doesn't exist
	// in the form (broken reference), which makes the rule fail open.
	// Multi-checkbox groups return an ARRAY of the checked values — the
	// array branch in rulePasses() mirrors RuleEvaluator::rulePasses().
	function fieldValue(uid, hiddenSet) {
		var wrap = form.querySelector('[data-rf-uid="' + uid + '"]');
		if (!wrap) {
			return null;
		}
		if (hiddenSet.has(uid)) {
			return '';
		}
		// Hidden-type fields carry data-rf-uid on the input itself (no wrapper)
		if (wrap.tagName === 'INPUT') {
			return wrap.value;
		}
		// Radio group: the checked radio's value, or empty
		if (wrap.querySelector('input[type="radio"]')) {
			var checkedRadio = wrap.querySelector('input[type="radio"]:checked');
			return checkedRadio ? checkedRadio.value : '';
		}
		var checkboxes = wrap.querySelectorAll('input[type="checkbox"]');
		if (checkboxes.length) {
			// Multi-checkbox group (name ends in []): array of checked values
			if (checkboxes[0].name.slice(-2) === '[]') {
				return Array.prototype.filter
					.call(checkboxes, function (checkbox) { return checkbox.checked; })
					.map(function (checkbox) { return checkbox.value; });
			}
			// Single checkbox / consent: boolean semantics as '1'/''
			return checkboxes[0].checked ? '1' : '';
		}
		var input = wrap.querySelector('input, select, textarea');
		// Layout-only field (heading/paragraph): no input, no value. Fail
		// open like the server, where these uids never enter formData.
		if (!input) {
			return null;
		}
		// File field: compare the chosen filename, not the browser's
		// C:\fakepath\ value — the server evaluates rules against the
		// pending upload's client filename, which is this same string
		if (input.type === 'file') {
			return input.files && input.files.length ? input.files[0].name : '';
		}
		return input.value;
	}

	// Mirrors RuleEvaluator::rulePasses(): malformed rules, unknown
	// operators and broken field references all pass — never hide
	function rulePasses(rule, hiddenSet) {
		if (!rule || !rule.field || !rule.operator) {
			return true;
		}
		var raw = fieldValue(rule.field, hiddenSet);
		if (raw === null) {
			return true;
		}
		var expected = normalize(rule.value);
		// Multi-value fields (checkboxes): a rule matches when ANY selected
		// option satisfies it; isNot passes only when NO option matches.
		// Strict parity with the array branch in RuleEvaluator::rulePasses().
		if (Array.isArray(raw)) {
			var selected = raw.map(normalize).filter(function (value) { return value !== ''; });
			switch (rule.operator) {
				case 'is':
					return selected.indexOf(expected) !== -1;
				case 'isNot':
					return selected.indexOf(expected) === -1;
				case 'contains':
					return selected.some(function (value) { return value.indexOf(expected) !== -1; });
				case 'isEmpty':
					return selected.length === 0;
				case 'isNotEmpty':
					return selected.length > 0;
				default:
					return true;
			}
		}
		var actual = normalize(raw);
		switch (rule.operator) {
			case 'is':
				return actual === expected;
			case 'isNot':
				return actual !== expected;
			case 'contains':
				return actual.indexOf(expected) !== -1;
			case 'isEmpty':
				return actual === '';
			case 'isNotEmpty':
				return actual !== '';
			default:
				return true;
		}
	}

	// Mirrors RuleEvaluator::isVisible(): 'any' = first pass wins,
	// anything but 'any' behaves as 'all' = first failure hides
	function isVisible(conditions, hiddenSet) {
		if (!conditions || !Array.isArray(conditions.rules) || !conditions.rules.length) {
			return true;
		}
		var any = conditions.mode === 'any';
		for (var i = 0; i < conditions.rules.length; i++) {
			var passes = rulePasses(conditions.rules[i], hiddenSet);
			if (any && passes) {
				return true;
			}
			if (!any && !passes) {
				return false;
			}
		}
		return !any;
	}

	// Apply a field's visibility: hidden fields don't post (disabled) and
	// are never required; the original required flag is stashed so showing
	// the field restores it
	function apply(wrap, visible) {
		wrap.toggleAttribute('hidden', !visible);
		// Hidden-type fields carry the conditions on the input itself
		var inputs = wrap.tagName === 'INPUT'
			? [wrap]
			: wrap.querySelectorAll('input, select, textarea');
		inputs.forEach(function (input) {
			input.disabled = !visible;
			if (!visible) {
				if (input.required) {
					input.dataset.rfRequired = '1';
				}
				input.required = false;
			} else if (input.dataset.rfRequired) {
				input.required = true;
			}
		});
	}

	// Re-evaluate everything until the hidden set is stable, so chained
	// conditions (B depends on A, C depends on B) settle in one call —
	// same fixpoint as RuleEvaluator::hiddenFieldUids(). The set only
	// grows within a run, so this terminates in at most N passes.
	function evaluate() {
		var hiddenSet = new Set();
		var passes = conditioned.length;
		var changed = true;
		while (changed && passes-- > 0) {
			changed = false;
			conditioned.forEach(function (wrap) {
				var uid = wrap.getAttribute('data-rf-uid');
				if (hiddenSet.has(uid)) {
					return;
				}
				var conditions = null;
				try {
					conditions = JSON.parse(wrap.getAttribute('data-rf-conditions'));
				} catch (e) {
					// Unparseable conditions: fail open, keep the field visible
					return;
				}
				if (!isVisible(conditions, hiddenSet)) {
					hiddenSet.add(uid);
					changed = true;
				}
			});
		}
		conditioned.forEach(function (wrap) {
			apply(wrap, !hiddenSet.has(wrap.getAttribute('data-rf-uid')));
		});
	}

	// 'input' covers typing, 'change' covers selects/checkboxes and autofill
	form.addEventListener('input', evaluate);
	form.addEventListener('change', evaluate);

	// Initial state on load (also correct after a server-side error re-render)
	evaluate();
})();
{% endjs %}
