{# reCAPTCHA v3: hidden token input, populated on submit. The form is
   submitted after grecaptcha delivers a token; if grecaptcha fails to load
   (blocked, offline) the form still submits — the back end then decides
   based on the fail-open setting rather than silently rejecting. #}
<input type="hidden" name="g-recaptcha-response" value="" />
{% js "https://www.google.com/recaptcha/api.js?render=#{siteKey}" %}
{% js %}
	(function () {
		var forms = document.querySelectorAll('form');
		forms.forEach(function (form) {
			var tokenInput = form.querySelector('input[name="g-recaptcha-response"]');
			if (!tokenInput || form.dataset.efRecaptchaBound) return;
			form.dataset.efRecaptchaBound = '1';
			form.addEventListener('submit', function (event) {
				if (form.dataset.efTokenReady || typeof grecaptcha === 'undefined') return;
				event.preventDefault();
				grecaptcha.ready(function () {
					grecaptcha
						.execute('{{ siteKey }}', { action: 'submit' })
						.then(function (token) {
							tokenInput.value = token;
							form.dataset.efTokenReady = '1';
							form.requestSubmit();
						})
						.catch(function () {
							// Token fetch failed: submit anyway, back end handles it honestly
							form.dataset.efTokenReady = '1';
							form.requestSubmit();
						});
				});
			});
		});
	})();
{% endjs %}
