{# Self-service view: a submitter sees (and may delete) their own submission,
   reached via the tokenized link in the confirmation email. Bare-bones
   standalone page — override per project with templates/recranet-forms/submission.twig
   to embed it in the site layout. #}
<!doctype html>
<html lang="{{ craft.app.language }}">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{{ 'submission.title'|t('recranet-forms') }}</title>
		<style>
			body { font-family: system-ui, sans-serif; max-width: 640px; margin: 40px auto; padding: 0 16px; color: #1e2a44; }
			table { border-collapse: collapse; width: 100%; margin: 24px 0; }
			th, td { text-align: left; padding: 8px 12px; border-bottom: 1px solid #e5e9f0; vertical-align: top; }
			th { width: 35%; color: #5b6a88; font-weight: 600; }
			button { background: #b91c1c; color: #fff; border: 0; border-radius: 8px; padding: 10px 18px; cursor: pointer; }
		</style>
	</head>
	<body>
		<h1>{{ 'submission.title'|t('recranet-forms') }}</h1>
		<p>{{ 'submission.intro'|t('recranet-forms') }}</p>

		<table>
			<tbody>
				<tr>
					<th>{{ 'submission.date'|t('recranet-forms') }}</th>
					<td>{{ submission.dateCreated|datetime('short') }}</td>
				</tr>
				{% for row in submission.values %}
					<tr>
						<th>{{ row.label|t }}</th>
						<td>
							{% if row.type == 'checkbox' or row.type == 'consent' %}
								{{ row.value ? 'submission.yes'|t('recranet-forms') : 'submission.no'|t('recranet-forms') }}
							{% elseif row.type == 'file' %}
								{# The submitter only gets the filename — never a CP link #}
								{% set asset = row.value ? craft.assets.id(row.value).one() : null %}
								{{ asset ? asset.filename : '' }}
							{% elseif row.value is iterable %}
								{# Multi-value fields (checkboxes) read as a comma-joined list #}
								{{ row.value|join(', ') }}
							{% else %}
								{{ row.value|nl2br }}
							{% endif %}
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>

		{# AVG erasure: hard delete, gated by the token + a confirm #}
		<form
			method="post"
			onsubmit="return confirm('{{ 'submission.deleteConfirm'|t('recranet-forms') }}');"
		>
			{{ csrfInput() }}
			{{ actionInput('recranet-forms/submissions/delete-by-token') }}
			{{ hiddenInput('token', submission.token) }}
			<button type="submit">{{ 'submission.delete'|t('recranet-forms') }}</button>
		</form>
	</body>
</html>
