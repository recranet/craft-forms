{# Owner notification email: all submitted values in a simple table.
   Override per project with templates/elloro-forms/_emails/notification.twig. #}
<h2>{{ form.name }}</h2>
<table cellpadding="6" cellspacing="0" border="0">
	{% for field in form.fields %}
		{% set value = submission.content[field.handle] ?? null %}
		<tr>
			<td style="vertical-align: top;"><strong>{{ field.label }}</strong></td>
			<td>
				{% if field.type == 'checkbox' %}
					{{ value ? 'Yes' : 'No' }}
				{% else %}
					{{ value|nl2br }}
				{% endif %}
			</td>
		</tr>
	{% endfor %}
</table>
{% if submission.spamReason %}
	{# Fail-open acceptance: make the config problem visible to the recipient too #}
	<p style="color: #b45309;"><em>Note: {{ submission.spamReason }}</em></p>
{% endif %}
