{# Owner notification email: all submitted values in a simple table.
   Values come from submission.values (resolved via the submit-time snapshot,
   so renamed fields keep their historical labels).
   Override per project with templates/recranet-forms/_emails/notification.twig. #}
<h2>{{ form.name }}{% if submission.incrementalId %} — #{{ submission.incrementalId }}{% endif %}</h2>
{# Editor-managed intro from the form's mail settings (merge tags rendered) #}
{% if intro %}
	<p>{{ intro|nl2br }}</p>
{% endif %}
<table cellpadding="6" cellspacing="0" border="0">
	{% for row in submission.values %}
		<tr>
			<td style="vertical-align: top;"><strong>{{ row.label }}</strong></td>
			<td>
				{% if row.type == 'checkbox' %}
					{{ row.value ? 'Yes' : 'No' }}
				{% else %}
					{{ row.value|nl2br }}
				{% endif %}
			</td>
		</tr>
	{% endfor %}
</table>
{% if submission.spamReason %}
	{# Fail-open acceptance: make the config problem visible to the recipient too #}
	<p style="color: #b45309;"><em>Note: {{ submission.spamReason }}</em></p>
{% endif %}
