{# Confirmation email to the submitter.
   `bodyText` is the editor-managed body from the form's mail settings
   (merge tags already rendered); empty = the translated default line.
   Override per project with templates/recranet-forms/_emails/confirmation.twig. #}
{% if bodyText %}
	<p>{{ bodyText|nl2br }}</p>
{% else %}
	<p>{{ 'confirmation.body'|t('recranet-forms') }}</p>
{% endif %}
<h3>{{ form.name }}</h3>
<table cellpadding="6" cellspacing="0" border="0">
	{% for row in submission.values %}
		<tr>
			<td style="vertical-align: top;"><strong>{{ row.label }}</strong></td>
			<td>
				{% if row.type == 'checkbox' %}
					{{ row.value ? 'Yes' : 'No' }}
				{% else %}
					{{ row.value|nl2br }}
				{% endif %}
			</td>
		</tr>
	{% endfor %}
</table>
