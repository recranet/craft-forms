{# Confirmation email to the submitter.
   Override per project with templates/recranet-forms/_emails/confirmation.twig. #}
<p>{{ 'confirmation.body'|t('recranet-forms') }}</p>
<h3>{{ form.name }}</h3>
<table cellpadding="6" cellspacing="0" border="0">
	{# submission.values resolves via the snapshot (formData is uid-keyed) and
	   already excludes layout-only rows (heading, paragraph) #}
	{% for row in submission.values %}
		<tr>
			<td style="vertical-align: top;"><strong>{{ row.label }}</strong></td>
			<td>
				{% if row.type == 'checkbox' or row.type == 'consent' %}
					{{ (row.value ? 'Yes' : 'No')|t('recranet-forms') }}
				{% elseif row.type == 'file' %}
					{# Visitors only get the filename — never a CP link #}
					{% set asset = row.value ? craft.assets.id(row.value).one() : null %}
					{{ asset ? asset.filename : '' }}
				{% elseif row.value is iterable %}
					{# Multi-value fields (checkboxes) read as a comma-joined list #}
					{{ row.value|join(', ') }}
				{% else %}
					{{ row.value|nl2br }}
				{% endif %}
			</td>
		</tr>
	{% endfor %}
</table>
